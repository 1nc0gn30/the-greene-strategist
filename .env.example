# Netlify Functions server-side key for strategist chat.
# Keep this secret and set it in Netlify UI (Site settings -> Environment variables).
OLLAMA_API_KEY="YOUR_OLLAMA_CLOUD_API_KEY"

# Optional.
# Native Ollama API base: https://api.ollama.com/api
# OpenAI-compatible base: https://api.ollama.com/v1
OLLAMA_BASE_URL="https://api.ollama.com/v1"

# Optional. Defaults to gemma4
OLLAMA_MODEL="gemma4"

# Optional public URL used for canonical metadata in some builds.
APP_URL="https://the-greene-strategist.nealfrazier.tech"
